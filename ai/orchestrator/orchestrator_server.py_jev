import json
import sys
from http.server import BaseHTTPRequestHandler, HTTPServer

sys.path.insert(
    0,
    "/projects/minibank/ai/orchestrator"
)

from ai_pipeline import (
    call_qwen,
    call_jev,
    run_guardrail,
    build_report
)


HOST = "0.0.0.0"
PORT = 9200


def run_ai_pipeline(context):

    print("[1/4] Qwen RCA analysis...")
    qwen_result = call_qwen(context)

    print("[2/4] Jev independent evaluation...")
    jev_result = call_jev(
        context,
        qwen_result
    )

    print("[3/4] Deterministic guardrail...")
    guardrail_result = run_guardrail(
        context,
        qwen_result,
        jev_result
    )

    print("[4/4] Building RCA report...")
    report = build_report(
        context,
        qwen_result,
        jev_result,
        guardrail_result
    )

    return report


class OrchestratorHandler(BaseHTTPRequestHandler):

    def send_json(self, status_code, payload):

        body = json.dumps(
            payload,
            indent=2
        ).encode("utf-8")

        self.send_response(status_code)
        self.send_header(
            "Content-Type",
            "application/json"
        )
        self.send_header(
            "Content-Length",
            str(len(body))
        )
        self.end_headers()

        self.wfile.write(body)


    def do_GET(self):

        if self.path == "/health":

            self.send_json(
                200,
                {
                    "status": "UP",
                    "service": "minibank-ai-orchestrator"
                }
            )

            return

        self.send_json(
            404,
            {
                "error": "Not Found"
            }
        )


    def do_POST(self):

        if self.path != "/api/analyze":

            self.send_json(
                404,
                {
                    "error": "Not Found"
                }
            )

            return

        try:

            content_length = int(
                self.headers.get(
                    "Content-Length",
                    0
                )
            )

            if content_length <= 0:

                self.send_json(
                    400,
                    {
                        "status": "ERROR",
                        "error": "Request body is empty"
                    }
                )

                return

            body = self.rfile.read(
                content_length
            )

            context = json.loads(
                body.decode("utf-8")
            )

            report = run_ai_pipeline(
                context
            )

            self.send_json(
                200,
                {
                    "status": "SUCCESS",
                    "report": report
                }
            )

        except json.JSONDecodeError as e:

            self.send_json(
                400,
                {
                    "status": "ERROR",
                    "error": (
                        f"Invalid JSON: {str(e)}"
                    )
                }
            )

        except Exception as e:

            print(
                f"Pipeline failed: "
                f"{type(e).__name__}: {e}"
            )

            self.send_json(
                500,
                {
                    "status": "ERROR",
                    "error_type": type(e).__name__,
                    "error": str(e)
                }
            )


    def log_message(
        self,
        format,
        *args
    ):

        print(
            f"[HTTP] "
            f"{self.address_string()} "
            f"{format % args}"
        )


def main():

    server = HTTPServer(
        (HOST, PORT),
        OrchestratorHandler
    )

    print("=" * 60)
    print("MiniBank AI Orchestrator")
    print("=" * 60)
    print(f"Listening on {HOST}:{PORT}")
    print("Health  : GET  /health")
    print("Analyze : POST /api/analyze")
    print()
    print(
        "IMPORTANT: This service does NOT "
        "execute remediation."
    )
    print("=" * 60)

    try:
        server.serve_forever()

    except KeyboardInterrupt:

        print("\nStopping orchestrator...")

        server.server_close()


if __name__ == "__main__":
    main()
